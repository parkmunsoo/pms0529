package Ex03;

@FunctionalInterface
interface Test {
    void add(int a, int b);
}

@FunctionalInterface
interface Three {
    void add1(int last_num);
}

public class pra0501 {
    public static void main(String[] args) {
        // TODO Auto-generated method stub
        Test test = (a, b) -> {
            int c = 10;
            System.out.println(a + b + c);
            System.out.println("a+b의 값은 " + (a + b));
        };
        test.add(5, 10);

        Three test1 = (last_num) -> {
            int result = 0;
            for (int i = 1; i <= last_num; i++) {
                if (i % 3 == 0) {
                    result += i;
                }
            }
            System.out.println("3의 배수의 합: " + result);
        };

        test1.add1(100);
    }
}