package pract_IO;

public class prct1 {
    public static void main(String[] args) {
        // 구구단 출력 예제
        for(int i = 1; i <= 9; i++) { 
        	System.out.println("처음항,"+"연산자,"+"두번째항,"+"등호,"+"결과");
            System.out.println("아래는" + i + "단의시작줄입니다");
            for(int j = 1; j <= 9; j++) { 
                System.out.print(i + "X" + j + "=" + (j * i) + " ");
            }
            System.out.println(); 
        }
    }
}

