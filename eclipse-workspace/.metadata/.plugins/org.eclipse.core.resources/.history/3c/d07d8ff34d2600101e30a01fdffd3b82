package Ex03;

import java.util.Arrays;
import java.util.List;

public class prac_stream {

    public static void main(String[] args) {
        List<Integer> numbers = Arrays.asList(-3, -1, 0, 2, 5, -10, 7);
        numbers.stream()
               .filter(n -> n > 0)
               .forEach(System.out::println);
    }
}